{
  "name": "parallax-evidence",
  "private": true,
  "version": "0.10.0-alpha.10",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "verify": "node scripts/verify.mjs",
    "dev": "vite --host 127.0.0.1",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "build": "node scripts/ensure-evaluation.mjs && node scripts/notices.mjs && tsc --noEmit && vite build && node scripts/build-offline.mjs",
    "preview": "node scripts/serve.mjs",
    "test:browser": "playwright test",
    "release:check": "node scripts/release-check.mjs",
    "evaluation:record": "node scripts/write-evaluation.mjs",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "lightningcss": "1.33.0",
    "prettier": "^3.10.1",
    "terser": "5.51.2",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.72.2",
    "vite": "^7.3.0",
    "vitest": "^4.0.0"
  },
  "overrides": {
    "minimatch": "11.0.1"
  }
}
